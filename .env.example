# ===== MONGODB =====
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/viberoom?retryWrites=true&w=majority

# ===== REDIS (Upstash) =====
REDIS_URL=rediss://:<password>@<endpoint>.upstash.io:6379

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ===== FIREBASE =====
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ===== NEXT.JS PUBLIC FIREBASE (client-side) =====
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456:web:abc123

# ===== RAZORPAY =====
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# ===== CLOUDINARY =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ===== GOOGLE TRANSLATE (leave empty to use mock) =====
GOOGLE_TRANSLATE_API_KEY=
USE_TRANSLATE_MOCK=true

# ===== TURN SERVER (Metered.ca) =====
TURN_SERVER_URL=turn:relay.metered.ca:80
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ===== APP URLS =====
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ===== SERVER =====
PORT=4000
NODE_ENV=development
